# Copie para .env.vps na VPS (chmod 600). NUNCA versione o .env.vps.
# Senha do PostgreSQL (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=
# Segredo dos tokens JWT e da criptografia das credenciais Cora (gere com: openssl rand -hex 48).
# Se trocar, as credenciais Cora salvas deixam de ser lidas e todos precisam logar de novo.
APP_SECRET=
# URL pública HTTPS (quando houver domínio) — usada na URL do webhook da Cora
PUBLIC_URL=
