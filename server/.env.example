# Porta da API (o frontend em produção é servido pela mesma porta)
PORT=3333
# Conexão com o PostgreSQL (obrigatória). As tabelas são criadas automaticamente na inicialização.
DATABASE_URL=postgres://gestaocontabil:senha@localhost:5432/gestaocontabil
# Segredo para tokens e criptografia das credenciais Cora. Se omitido, é gerado em data/.secret
APP_SECRET=
# URL pública HTTPS do sistema — usada para montar a URL do webhook da Cora
PUBLIC_URL=
# O administrador pré-cadastrado é definido em src/admin-seed.ts (e-mail + hash bcrypt da senha).
