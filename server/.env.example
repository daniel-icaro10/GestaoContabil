# Porta da API (o frontend em produção é servido pela mesma porta)
PORT=3333
# Segredo para tokens e criptografia das credenciais Cora. Se omitido, é gerado em data/.secret
APP_SECRET=
# URL pública HTTPS do sistema — usada para montar a URL do webhook da Cora
PUBLIC_URL=https://app.suaempresa.com.br
# Administrador criado no primeiro start
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
