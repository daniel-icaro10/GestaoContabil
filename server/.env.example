# Porta da API (o frontend em produção é servido pela mesma porta)
PORT=3333
# Segredo para tokens e criptografia das credenciais Cora. Se omitido, é gerado em data/.secret
APP_SECRET=
# URL pública HTTPS do sistema — usada para montar a URL do webhook da Cora (no Render é detectada automaticamente)
PUBLIC_URL=
# O administrador é criado no primeiro acesso pela tela /setup (código exibido no log ao iniciar).
